# Copy to .env on the server. Never commit .env.
API_DOMAIN=api.mankacommerceandconsultancy.co.in
# Letters and digits only (it goes inside a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

SITE_URL=https://mankacommerceandconsultancy.co.in
ALLOWED_ORIGINS=https://mankacommerceandconsultancy.co.in,https://www.mankacommerceandconsultancy.co.in

# Answer only on the custom domain (/health stays open for platform health checks).
ALLOWED_HOSTS=api.mankacommerceandconsultancy.co.in

# Password-reset email. On Render use the Brevo API key (SMTP ports are blocked there).
BREVO_API_KEY=

# Or SMTP via the existing Brevo relay (port 587; Oracle only blocks 25).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=contact@mankacommerceandconsultancy.co.in
